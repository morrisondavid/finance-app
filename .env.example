# Copy to `.env.local` (gitignored) and adjust paths.
# In Enable Control Panel, whitelist ENABLE_BANKING_REDIRECT_URL using the
# exact same string (scheme, host, port, path).

ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=secrets/enable-banking-private.pem
# Full URL of this app’s OAuth callback (whitelist the exact string in Enable Control Panel).
# Dev — hit Express directly (default PORT=3000):
#   http://127.0.0.1:3000/api/feed/enable/callback
# Dev — alternative: same path via Vite proxy if you prefer one origin in the browser:
#   http://127.0.0.1:5173/api/feed/enable/callback
# (localhost vs 127.0.0.1 are different strings — pick one and use it everywhere.)
ENABLE_BANKING_REDIRECT_URL=

# Enable Banking AIS registration: host `privacy.html` + `terms.html` from `npm run build` output and register URLs in the dashboard, e.g. https://<your-domain>/privacy.html and https://<your-domain>/terms.html

# --- TrueLayer Data API + OAuth ---
# Same pattern as Enable: whitelist TRUELAYER_REDIRECT_URL verbatim in TL Console,
# scopes: info accounts balance transactions offline_access.

TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# e.g. http://127.0.0.1:3000/api/feed/truelayer/callback (dev direct to Express)
# or https://<your-public-host>/api/feed/truelayer/callback in production (must match Caddy HTTPS hostname).
TRUELAYER_REDIRECT_URL=
# Defaults when unset — override for sandbox hosts if needed:
# TRUELAYER_AUTH_BASE=https://auth.truelayer.com
# TRUELAYER_API_BASE=https://api.truelayer.com
# Rare: pass through auth link helper (sandbox); leave unset locally.
# TRUELAYER_END_USER_EMAIL=
# Overrides default repo path `data/truelayer-tokens.local.json`:
# TRUELAYER_TOKENS_PATH=

# Optional: absolute or repo-relative path for opening-balances.csv (tests use this to avoid touching data/).
# BANK_STATEMENTS_OPENING_BALANCES_CSV=

# When truthy (default), skip initSchema + CSV rebuild if data/manifest.json digest
# still matches the durable tree (set to 0 or false to always full-rebuild).
# Production Docker (deploy/aws/09-docker-run-production.sh) sets BANK_STATEMENTS_SKIP_INIT_WHEN_MANIFEST_UNCHANGED=0.
# BANK_STATEMENTS_SKIP_INIT_WHEN_MANIFEST_UNCHANGED=
# Optional: sandbox / alternate API host if Enable documents one
# ENABLE_BANKING_API_BASE=https://api.enablebanking.com
# Optional: override default data/enable-sessions.json under the repo root
# ENABLE_BANKING_SESSION_PATH=

# --- S3 durable uploads (omit bucket locally — no pushes during dev / tests) ---
# EC2 `./09-docker-run-production.sh` runs host `aws s3 sync --delete` before Docker. When the bucket is set,
# Node uploads only files touched by mutations (no periodic or shutdown bulk push).
# BANK_S3_DURABLE_BUCKET=your-data-bucket-name
# BANK_S3_DURABLE_PREFIX=bank-state/prod
# BANK_S3_DURABLE_SSE_KMS_KEY_ID=          # optional KMS key for SSE-KMS on PutObject

# --- Production site gate (Express): omit locally so `/api/*` stays open during dev ---
# Long random secret (≥16 UTF-8 bytes). Enables Bearer auth + signed HttpOnly cookie sessions.
# BANK_SITE_ACCESS_SECRET=
# Optional human-only password for /login.html; Bearer tokens always use BANK_SITE_ACCESS_SECRET.
# BANK_SITE_LOGIN_PASSWORD=
