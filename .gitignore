# Dependencies
node_modules/

# Database (rebuilt from CSVs on startup)
data/

# Build output
dist/

# Environment
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Uploaded bank statements (personal financial data)
statements/

# Multer temp uploads
uploads/

# §3.1 — local net-worth history (CSV source of truth; back up outside git)
net-worth/net-worth-snapshots.csv

# §3.4 — Modular AISP feed: operational secrets / rotating session blobs.
# Keep these out of git; back them up outside the repo (or re-link the bank
# if lost — they aren't financial source of truth).
feed-sessions.local.json
feed-credentials.local.json

# Local secrets (Enable Banking private key, etc.). Set paths via env, e.g.
# ENABLE_BANKING_PRIVATE_KEY_PATH=secrets/enable-banking-private.pem
secrets/

# AWS deploy — copy deploy/aws/config.example.sh → config.sh (see deploy/aws/README.md)
deploy/aws/config.sh
deploy/aws/env.local.sh
deploy/aws/production-env.local.sh
deploy/aws/.elastic-ip
deploy/hostinger/config.sh
deploy/hostinger/production-env.local.sh

# Enable ASPSP list dumps (regenerate: npm run enable-banking -- aspsps GB --out aspsps-gb.json)
aspsps-*.json

./cursor/
Dockerfile
